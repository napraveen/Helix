# ==============================================================================
# HELIX — Environment Configuration (.env.example)
# Copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FalkorDB Connection (REQUIRED)
# ------------------------------------------------------------------------------
# Option A: Local Docker (Default)
# Run `npm run falkor:up` to start the local container.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=helix
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=

# Option B: FalkorDB Cloud (Uncomment if using cloud instance instead of local Docker)
# FALKORDB_URL=falkor://username:password@your-cloud-instance.cloud:port

# ------------------------------------------------------------------------------
# 2. AI Reasoning (OPTIONAL)
# Helix functions fully with deterministic OpenCypher query synthesis without an LLM.
# Add your Gemini API key to enable natural-language response synthesis.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. Application Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Helix

# ------------------------------------------------------------------------------
# 4. GitHub PR Triage & Ingestion (OPTIONAL)
# Needed only for live GitHub write mutations and real-time webhook sync.
# Leave mode as 'dryrun' to safely simulate GitHub mutations without a token.
# ------------------------------------------------------------------------------
# GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_READ_TARGETS=vercel/next.js
GITHUB_WRITE_REPO=demo-dev/helix-demo-ops
NEXT_PUBLIC_GITHUB_WRITE_REPO=demo-dev/helix-demo-ops
GITHUB_WEBHOOK_SECRET=helix-webhook-secret-graphhacks-2026
HELIX_ACTIONS_MODE=dryrun
HELIX_DEFAULT_TENANT=github-production
