# FalkorDB (required — the product does not run without it)
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=helix
# FALKORDB_PASSWORD=

# Gemini (optional but recommended). Without a key, Helix still answers from the graph.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# App
NEXT_PUBLIC_APP_NAME=Helix
